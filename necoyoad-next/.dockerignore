# Exclude symlinks + dev files from Docker build context
# The public/storage symlink causes "invalid file request" build errors
public/storage
storage/app/public
node_modules
vendor
.git
.gitignore
.env
.env.local
.phpunit.result.cache
docker-compose.yml
README.md
*.md
docs/
tests/
bootstrap/cache/config.php
bootstrap/cache/routes-v7.php
storage/logs/*.log
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
