{
	# FrankenPHP global options
	frankenphp {
		document_root /var/www/html/public
	}
}

# Necoyoad — Laravel 11 on FrankenPHP
# php_server executes .php files through FrankenPHP's PHP runtime.
# Without it, file_server serves index.php as a static text file (blank page).

:80 {
	root * /var/www/html/public

	# Enable compression
	encode zstd gzip

	# Serve static files (css, js, images) directly
	file_server

	# Execute PHP for all other requests (Laravel's front controller)
	# try_files falls back to index.php, php_server executes it
	try_files {path} /index.php?{query}
	php_server

	# Security: block access to sensitive dotfiles
	@hidden path /.env /.git /.htaccess /.DS_Store
	respond @hidden 404

	# Access logs to stdout (docker logs)
	log {
		output stdout
		format console
	}
}
