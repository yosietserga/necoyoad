{
	# FrankenPHP global options
	frankenphp {
		document_root /var/www/html/public
	}
	# Required: order php_server before file_server
	order php_server before file_server
}

# Necoyoad — Laravel 11 on FrankenPHP
# try_files checks if the file exists first — if it does, file_server serves
# it as static. If not, it rewrites to /index.php and php_server executes it.

:80 {
	root * /var/www/html/public
	encode zstd gzip

	# Block sensitive dotfiles
	@hidden path /.env /.git /.htaccess /.DS_Store
	respond @hidden 404

	# try_files: if {path} exists as a file, serve it via file_server.
	# If not, rewrite to /index.php and let php_server execute it.
	try_files {path} /index.php?{query}
	file_server
	php_server

	log {
		output stdout
		format console
	}
}
