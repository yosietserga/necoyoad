{
	# FrankenPHP global options
	frankenphp {
		document_root /var/www/html/public
	}
}

# Necoyoad — Laravel 11 on FrankenPHP
# The route block gives explicit ordering: try_files → php_server → file_server.
# This avoids the "not an ordered HTTP handler" error.

:80 {
	root * /var/www/html/public

	# Enable compression
	encode zstd gzip

	# Security: block access to sensitive dotfiles
	@hidden path /.env /.git /.htaccess /.DS_Store
	respond @hidden 404

	# Explicit route ordering — Caddy processes these top-to-bottom
	route {
		# Rewrite non-existent paths to index.php (Laravel's front controller)
		try_files {path} /index.php?{query}
		# Execute PHP files through FrankenPHP
		php_server
		# Serve static files (CSS, JS, images) directly
		file_server
	}

	# Access logs to stdout (docker logs)
	log {
		output stdout
		format console
	}
}
