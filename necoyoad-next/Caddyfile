{
	# FrankenPHP global options
	frankenphp {
		document_root /var/www/html/public
	}
}

# Necoyoad — Laravel 11 on FrankenPHP
# file_server serves static files (CSS, JS, images) directly.
# try_files rewrites non-existent paths to index.php (Laravel's front controller).
# php_server executes index.php via FrankenPHP.

:80 {
	root * /var/www/html/public
	encode zstd gzip

	# Block sensitive dotfiles
	@hidden path /.env /.git /.htaccess /.DS_Store
	respond @hidden 404

	# Serve static files FIRST (CSS, JS, images) — if the file exists, serve it
	# and stop. Only fall through to PHP if the file doesn't exist.
	@static {
		file {
			try_files {path}
		}
	}
	file_server @static

	# Everything else goes to Laravel's front controller
	try_files {path} /index.php?{query}
	php_server

	log {
		output stdout
		format console
	}
}
