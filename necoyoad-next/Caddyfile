{
	# FrankenPHP global options — this enables PHP execution automatically
	frankenphp {
		document_root /var/www/html/public
	}
	# Order php_server before file_server (required by Caddy)
	order php_server before file_server
}

# Necoyoad — Laravel 11 on FrankenPHP
# With frankenphp.document_root set + order directive, Caddy executes
# .php files via FrankenPHP and serves static files via file_server.

:80 {
	root * /var/www/html/public
	encode zstd gzip

	# Block sensitive dotfiles
	@hidden path /.env /.git /.htaccess /.DS_Store
	respond @hidden 404

	# try_files rewrites to index.php, then php_server executes it
	try_files {path} /index.php?{query}
	php_server
	file_server

	log {
		output stdout
		format console
	}
}
